# Variáveis de ambiente do frontend (Vite).
# Copie este arquivo para `.env.local` no desenvolvimento local
# e cadastre estes mesmos valores no painel da Vercel:
# Project Settings -> Environment Variables.
#
# IMPORTANTE: como o Vite embute `import.meta.env.VITE_*` em tempo de build,
# estas variáveis precisam existir na Vercel ANTES do build, senão o app
# sobe com tela branca (o createClient do Supabase quebra).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-anon-public-key-aqui
